<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <category label="General">
        <setting id="tmdb_key" type="text" label="Clave de TMDB" default=""/>
        <setting type="action" label="Escribir o comprobar la clave de TMDB" action="RunPlugin(plugin://plugin.video.palantix/?accion=tmdb_clave)"/>
        <setting id="auto_actualizar" type="bool" label="Actualizar Palantix solo cuando haya versión nueva" default="true"/>
        <setting type="action" label="Buscar actualización ahora" action="RunPlugin(plugin://plugin.video.palantix/?accion=actualizar)"/>
        <setting id="idioma_cat" type="enum" label="Idioma de títulos y sinopsis" values="Español (España)|Español (Latinoamérica)|English|Français|Italiano|Português|Deutsch" default="0"/>
        <setting type="action" label="Poner todo Kodi en español (botones, menús y ajustes)" action="RunPlugin(plugin://plugin.video.palantix/?accion=kodi_es)"/>
        <setting id="preguntado_idioma" type="text" label="" default="" visible="false"/>
    </category>
    <category label="Catálogo">
        <setting id="inicio_plataforma" type="bool" label="Pantalla de inicio con carteles y filas de carátulas" default="true"/>
        <setting id="vista_listados" type="enum" label="Vista de películas y series" values="Carátulas grandes|Mosaico|Mosaico con información|Lista" default="0"/>
        <setting id="orden_listas" type="enum" label="Orden de géneros y años" values="Más populares|Más recientes|Mejor valoradas|Alfabético" default="0"/>
        <setting id="paginas" type="enum" label="Elementos por pantalla" values="20|40|60" default="0"/>
        <setting id="recordar_busquedas" type="bool" label="Recordar las últimas búsquedas" default="true"/>
        <setting id="mostrar_etiquetas" type="bool" label="Mostrar idioma y calidad en los títulos" default="true"/>
        <setting id="color_etiquetas" type="enum" label="Color de las etiquetas" values="Sin color|Dorado|Azul|Verde|Naranja|Violeta|Blanco" default="1"/>
    </category>
    <category label="Reproducción">
        <setting id="idioma_pref" type="enum" label="Idioma preferido" values="Castellano|Latino|VOSE|Versión original|Me da igual" default="0"/>
        <setting id="solo_idioma" type="bool" label="Ocultar fuentes en otros idiomas" default="false"/>
        <setting id="calidad_max" type="enum" label="Calidad máxima (baja si tu conexión es lenta)" values="4K|1080p|720p" default="0"/>
        <setting id="autoplay" type="bool" label="Reproducción automática (elige la mejor fuente sin preguntar)" default="false"/>
        <setting type="lsep" label="Series"/>
        <setting id="intro_activo" type="bool" label="Botón «Saltar intro» (capítulos del vídeo y lo que aprende de ti)" default="true"/>
        <setting id="siguiente_activo" type="bool" label="Ofrecer el siguiente capítulo al acabar" default="true"/>
        <setting id="aviso_novedades" type="bool" label="Avisarme en la tele cuando salga un capítulo nuevo" default="true"/>
        <setting id="ocultar_al_dia" type="bool" label="En «Seguir viendo», ocultar las series que tengo al día" default="true"/>
        <setting id="siguiente_seg" type="slider" label="Avisar cuando falten (segundos)" default="30" range="10,5,120" option="int"/>
    </category>
    <category label="Subtítulos">
        <setting id="subs_modo" type="enum" label="Poner subtítulos automáticamente" values="Nunca|Si el audio no está en mi idioma|Siempre" default="1"/>
        <setting id="subs_idiomas" type="text" label="Idiomas (códigos separados por comas)" default="es"/>
        <setting type="lsep" label="OpenSubtitles (clave gratuita en opensubtitles.com > API consumers)"/>
        <setting id="os_apikey" type="text" label="Clave de la API" default=""/>
        <setting id="os_usuario" type="text" label="Usuario (opcional, da más descargas al día)" default=""/>
        <setting id="os_clave" type="text" label="Contraseña" default="" option="hidden"/>
    </category>
    <category label="Mis listas">
        <setting type="action" label="Añadir, ver o quitar mis listas" action="ActivateWindow(Videos,plugin://plugin.video.palantix/?accion=listas,return)"/>
        <setting id="lista_1" type="text" label="" default="" visible="false"/>
        <setting id="lista_2" type="text" label="" default="" visible="false"/>
        <setting id="lista_3" type="text" label="" default="" visible="false"/>
        <setting id="cache_min" type="number" label="Refrescar listas cada (minutos)" default="60"/>
    </category>
    <category label="Servicios Debrid">
        <setting id="aviso_caducidad" type="bool" label="Avisar cuando falten 7 días o menos para que caduque la cuenta" default="true"/>
        <setting id="ultimo_aviso" type="text" label="" default="" visible="false"/>
        <setting type="lsep" label="Se usan en este orden para alojamientos y magnets; si uno falla, se prueba el siguiente"/>
        <setting type="lsep" label="AllDebrid"/>
        <setting id="ad_activo" type="bool" label="Usar AllDebrid" default="false"/>
        <setting type="action" label="Vincular con un código en pantalla" action="RunPlugin(plugin://plugin.video.palantix/?accion=vincular&amp;s=ad)"/>
        <setting type="action" label="Ver mi cuenta" action="RunPlugin(plugin://plugin.video.palantix/?accion=cuenta&amp;s=ad)"/>
        <setting id="ad_apikey" type="text" label="" default="" visible="false"/>
        <setting type="lsep" label="Real-Debrid"/>
        <setting id="rd_activo" type="bool" label="Usar Real-Debrid" default="false"/>
        <setting type="action" label="Vincular con un código en pantalla" action="RunPlugin(plugin://plugin.video.palantix/?accion=vincular&amp;s=rd)"/>
        <setting type="action" label="Ver mi cuenta" action="RunPlugin(plugin://plugin.video.palantix/?accion=cuenta&amp;s=rd)"/>
        <setting id="rd_token" type="text" label="" default="" visible="false"/>
        <setting id="rd_refresh" type="text" label="" default="" visible="false"/>
        <setting id="rd_client_id" type="text" label="" default="" visible="false"/>
        <setting id="rd_client_secret" type="text" label="" default="" visible="false"/>
        <setting id="rd_caduca" type="text" label="" default="" visible="false"/>
        <setting type="lsep" label="Premiumize"/>
        <setting id="pm_activo" type="bool" label="Usar Premiumize" default="false"/>
        <setting type="action" label="Vincular pegando la clave de la API" action="RunPlugin(plugin://plugin.video.palantix/?accion=vincular&amp;s=pm)"/>
        <setting type="action" label="Ver mi cuenta" action="RunPlugin(plugin://plugin.video.palantix/?accion=cuenta&amp;s=pm)"/>
        <setting id="pm_apikey" type="text" label="" default="" visible="false"/>
        <setting type="lsep" label="TorBox"/>
        <setting id="tb_activo" type="bool" label="Usar TorBox" default="false"/>
        <setting type="action" label="Vincular pegando la clave de la API" action="RunPlugin(plugin://plugin.video.palantix/?accion=vincular&amp;s=tb)"/>
        <setting type="action" label="Ver mi cuenta" action="RunPlugin(plugin://plugin.video.palantix/?accion=cuenta&amp;s=tb)"/>
        <setting id="tb_apikey" type="text" label="" default="" visible="false"/>
    </category>
    <category label="Trakt">
        <setting id="trakt_activo" type="bool" label="Usar Trakt (visto automático, pendientes y listas)" default="false"/>
        <setting type="lsep" label="1) Crea tu app en trakt.tv/oauth/applications · redirect: urn:ietf:wg:oauth:2.0:oob"/>
        <setting id="trakt_client_id" type="text" label="Client ID" default=""/>
        <setting id="trakt_client_secret" type="text" label="Client Secret" default="" option="hidden"/>
        <setting type="action" label="2) Vincular con un código en pantalla" action="RunPlugin(plugin://plugin.video.palantix/?accion=vincular&amp;s=trakt)"/>
        <setting type="action" label="Ver mi cuenta" action="RunPlugin(plugin://plugin.video.palantix/?accion=cuenta&amp;s=trakt)"/>
        <setting id="trakt_listas_auto" type="bool" label="Añadir mis listas personales al menú principal" default="true"/>
        <setting id="trakt_valorar" type="enum" label="Preguntar qué te ha parecido al terminar" values="Nunca|A veces|Siempre" default="1"/>
        <setting id="trakt_token" type="text" label="" default="" visible="false"/>
        <setting id="trakt_refresh" type="text" label="" default="" visible="false"/>
        <setting id="trakt_caduca" type="text" label="" default="" visible="false"/>
    </category>
    <category label="Fuentes">
        <setting id="prov_stremio" type="bool" label="Buscar fuentes en complementos de Stremio" default="false"/>
        <setting type="lsep" label="Usa estos complementos solo para contenido que tengas autorización para reproducir"/>
        <setting id="stremio_1" type="text" label="URL HTTPS del manifiesto (1)" default="" option="hidden"/>
        <setting id="stremio_2" type="text" label="URL HTTPS del manifiesto (2)" default="" option="hidden"/>
        <setting id="stremio_3" type="text" label="URL HTTPS del manifiesto (3)" default="" option="hidden"/>
        <setting id="prov_archive_org" type="bool" label="Internet Archive (dominio público)" default="true"/>
        <setting id="prov_listas" type="bool" label="Buscar también en Mis listas" default="true"/>
    </category>
</settings>
